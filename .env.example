# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-secret-key
WTF_CSRF_ENABLED=True

# Cloud Open-Source PostgreSQL (Recommended so zero DB files are stored on your PC)
# - Neon (https://neon.tech): postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# - Supabase (https://supabase.com): postgresql://postgres.[ref]:pass@aws-0-xx.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
# Leave TEST_DATABASE_URL empty to run automated pytest tests against fast in-memory SQLite,
# or point it to a separate test PostgreSQL database.
TEST_DATABASE_URL=

# File Upload Settings
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=50

# AI / LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VERIFIER_MODEL=gemini-2.5-pro
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# OCR Configuration (optional path to tesseract executable)
TESSERACT_CMD=

# Background Worker Configuration (optional Celery/Redis; defaults to built-in async runner)
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Default Admin Seed Credentials (override before production deploy)
DEFAULT_ADMIN_EMAIL=admin@gateintelligence.local
DEFAULT_ADMIN_PASSWORD=Admin@Gate2026!
